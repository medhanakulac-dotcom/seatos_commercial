{
  "functions": {
    "api/ow.js": {
      "maxDuration": 300,
      "includeFiles": "server/operator-watch/{dist,migrations}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/ow/:path*",
      "destination": "/api/ow"
    },
    {
      "source": "/((?!api/|playbook\\.html|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/"
    }
  ]
}
