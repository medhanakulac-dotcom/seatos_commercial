{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/ow.js": {
      "maxDuration": 300,
      "includeFiles": "server/operator-watch/{dist,migrations}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/ow/:path*",
      "destination": "/api/ow"
    },
    {
      "source": "/((?!api/|playbook\\.html|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
