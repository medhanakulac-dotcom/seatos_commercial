# Copy to .env (gitignored) for local development. Never commit real tokens.

# CRM source for the Commercial Workspace: mock (synthetic fixture) or hubspot (live, read-only)
CRM_SOURCE=mock

# HubSpot private app token (Settings → Integrations → Private apps). Required when CRM_SOURCE=hubspot.
# Scopes: crm.objects.deals.read, crm.objects.companies.read, crm.objects.contacts.read, crm.objects.owners.read
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_NAME=SeatOS
# Where the commercial data lives in HubSpot (confirmed on portal 48205146; `npm run hubspot:discover` re-checks)
HUBSPOT_HEALTH_PROPERTY=health_status
HUBSPOT_SEGMENT_PROPERTY=client_segment
HUBSPOT_SEGMENT_OBJECT=deal
# Deal dropdown first, then the company's free-text country
HUBSPOT_COUNTRY_PROPERTY=country
HUBSPOT_COMPANY_COUNTRY_PROPERTY=country
# Map extra client_segment values if they start being used, e.g. "Medium High=High;At Risk=Dormant"
HUBSPOT_SEGMENT_MAP=
HUBSPOT_PRIMARY_PIPELINE=Client Pipeline
# Opt-in write-back of workspace notes to the deal (needs a notes write scope). Off by default.
HUBSPOT_NOTES_ENABLED=false

# Local http only: Safari rejects Secure cookies on http://localhost (ignored when NODE_ENV=production)
SESSION_COOKIE_SECURE=false

# Roles. Every user has exactly one role (admin | analyst | viewer), stored in Postgres and changed by an admin
# (PUT /admin/users/:id/role). New Google users start as AUTH_DEFAULT_ROLE (never admin); emails listed in
# AUTH_ADMIN_EMAILS become admin on first sign-in — the way to get the first administrator.
AUTH_ADMIN_EMAILS=
# AUTH_DEFAULT_ROLE=viewer

# Local-only sign-in button, shown only to browsers on localhost and never in production. It signs in a mocked
# user, developer@seatos.test, whose role follows AUTH_DEV_ROLE. It cannot collide with a real Google account.
AUTH_DEV_LOGIN=true
AUTH_DEV_ROLE=admin

# Postgres (compose `db` service is published on localhost:5433). Without it, non-production runs in memory.
DATABASE_URL=postgres://commercial:commercial-local@localhost:5433/commercial
# DATABASE_MIGRATE=false   # skip applying migrations/ on startup

# Email server for the "Email server (SMTP)" channel. Locally: Mailpit (UI http://localhost:8025) — nothing leaves the machine.
# Hermes never sends email; the backend's send queue does, over this SMTP connection. Invalid values stop the app at boot.
SMTP_HOST=localhost
# Default 587 (STARTTLS); 465 implies implicit TLS.
SMTP_PORT=1025
# true = implicit TLS from the first byte.
SMTP_SECURE=false
# Refuse to send unencrypted; defaults to true when NODE_ENV=production.
# SMTP_REQUIRE_TLS=true
# Set SMTP_USER and SMTP_PASSWORD together, or leave both empty.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=30000
# The one shared From identity. Settings → Sending can override it; if neither is set, SMTP sends are refused.
SMTP_FROM_ADDRESS=cs@seatos.com
SMTP_FROM_NAME=SeatOS Customer Success
# Emails this instance hands to mail providers per minute (0 = no cap).
# SEND_MAX_PER_MINUTE=30
# Outside production, customers are NEVER emailed unless this is true (use Settings → test-mode redirect instead).
SENDING_ALLOW_REAL_RECIPIENTS=false

# Hermes: webhook signing secret (same value in the Hermes webhook route) and the bearer token Hermes uses for /api/mcp.
# Generate with: openssl rand -base64 32
HERMES_WEBHOOK_SECRET=
AGENT_API_TOKEN=
# WORKSPACE_WORKERS=false  # disable the in-process scheduler and send worker

# Hermes API server of the operator-watch-ai profile (API_SERVER_* in ~/.hermes/profiles/operator-watch-ai/.env).
# When set, every operator gets its own persistent Hermes session (id opw-<operatorId>) used by the account chat AND by runs.
# Unset = the account chat is "not connected" and runs use the HERMES_WEBHOOK_SECRET webhook instead.
HERMES_API_URL=
HERMES_API_KEY=
# HERMES_CONCURRENCY=3  # operator sessions worked in parallel during a run

# SeatOS operator directory: MCP server (Streamable HTTP) exposing the tms:lookupOperator tool. Operator ids are resolved
# once per account and handed to agents. Unset = no resolution (accounts stay "unresolved").
# Outside Docker use http://localhost:3007/mcp; docker-compose.yml sets the host.docker.internal form.
TMS_TOOLS_MCP_URL=

# Extra browser origins allowed to open the chat websocket, besides the site's own origin (comma-separated). Dev only.
# CHAT_ALLOWED_ORIGINS=http://localhost:5173
