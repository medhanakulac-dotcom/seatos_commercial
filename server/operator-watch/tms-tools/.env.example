PORT=3000
HOST=0.0.0.0
# Authentication: mock is test/development only; production fails closed.
SERVICE_TOKEN_MODE=production
INTERNAL_SERVICE_TOKEN=
# Preferred production JWT mode (Ed25519 SPKI DER keys, base64 JSON map by kid)
SERVICE_TOKEN_PUBLIC_KEYS={}
SERVICE_TOKEN_ISSUER=reporting
SERVICE_TOKEN_AUDIENCE=tms-tools
SERVICE_TOKEN_CLOCK_SKEW_SECONDS=30

# Read-only TMS MySQL adapter (required outside mock mode; never point at a write user)
TMS_DB_HOST=
TMS_DB_PORT=3306
TMS_DB_USER=
TMS_DB_PASSWORD=
TMS_DB_NAME=tms
TMS_DB_OPERATOR_ID=
TMS_DB_SSL=true
TMS_DB_POOL_SIZE=5
