{
  "name": "seatos-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run ow:build && vite build",
    "preview": "vite preview",
    "test": "npm run ow:test && npm run web:test",
    "web:test": "vitest run",
    "web:typecheck": "tsc -p src/operator-watch/tsconfig.json",
    "ow:build": "tsc -p server/operator-watch/tsconfig.build.json",
    "ow:test": "jest -c server/operator-watch/jest.config.js --runInBand",
    "ow:start": "node server/operator-watch/dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.104.0",
    "@vercel/functions": "^3.9.11",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
